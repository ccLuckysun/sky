<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.DishMapper">

    <!-- 新增菜品。
         create_time、update_time、create_user、update_user 四列直接引用、没有 <if> 兜底，值来自 AutoFillAspect。
         dish.name 上有唯一索引 idx_dish_name，重名会抛 DuplicateKeyException，由业务层转成"菜品名称已存在"。 -->
    <insert id="insert" parameterType="Dish" useGeneratedKeys="true" keyProperty="id">
        insert into dish (name, category_id, price, image, description, status, create_time, update_time,
                          create_user, update_user)
        values (#{name}, #{categoryId}, #{price}, #{image}, #{description}, #{status}, #{createTime},
                #{updateTime}, #{createUser}, #{updateUser})
    </insert>

    <!-- 菜品分页查询：分页由 PageHelper 在此 SQL 之上追加 limit，并额外跑一次 count。
         resultType 必须写全类名：application.yml 的 type-aliases-package 只配了 com.sky.entity，
         短别名 DishVO 解析不到，写短名会在启动后第一次调用时抛 ClassNotFoundException。
         join 必须是 left join：dish.category_id 上没有外键、可能悬空，
         inner join 会让分类被删掉的菜品从列表里静默消失，列表总数也跟着对不上。
         c.name as category_name 靠 map-underscore-to-camel-case 映射到 categoryName。
         排序按最后操作时间倒序并追加 id 兜底：MySQL 不保证没有 order by 时的行序，
         只按 update_time 排会在时间相同的行之间产生随机顺序，翻页时出现重复或漏行。 -->
    <select id="pageQuery" resultType="com.sky.vo.DishVO">
        select d.id, d.name, d.category_id, d.price, d.image, d.description,
               d.status, d.update_time, c.name as category_name
        from dish d
        left join category c on d.category_id = c.id
        <where>
            <if test="name != null and name != ''">
                and d.name like concat('%', #{name}, '%')
            </if>
            <if test="categoryId != null">
                and d.category_id = #{categoryId}
            </if>
            <if test="status != null">
                and d.status = #{status}
            </if>
        </where>
        order by d.update_time desc, d.id desc
    </select>

    <!-- 按条件查询菜品列表（不分页）。供套餐页的选菜组件用：它发 ?categoryId=xx，也发 ?name=xx
         （关键字搜索那一支）。两个条件都可选、可叠加，都不传就返回全部菜品。
         **有意不加 d.status = 1 过滤**：选菜组件对 status = 0 的菜显式渲染「停售」标签，
         而且预置常量 SETMEAL_ENABLE_FAILED「套餐内包含未启售菜品，无法启售」说明停售菜品本就
         可以先进套餐、由套餐启售时兜底 —— 这里过滤掉会让两者都成为死代码。
         resultType 用短别名 Dish：type-aliases-package 配的就是 com.sky.entity（DishVO 不行，见 pageQuery）。
         列清单显式写全：接口文档的响应模型列了 create_time / create_user / update_user，
         它们只在实体上有，DishVO 里没有，所以这里返回的是实体而不是 VO。
         order by id 而不是 pageQuery 那套 update_time desc：本接口不分页，不需要"翻页稳定"，
         只需要一个确定的顺序；按主键排不会因为有人改了某道菜就把列表顺序抖乱，
         选菜的人一眼扫过去位置是固定的。 -->
    <select id="list" resultType="Dish">
        select id, name, category_id, price, image, description, status, create_time, update_time,
               create_user, update_user
        from dish
        <where>
            <if test="categoryId != null">
                and category_id = #{categoryId}
            </if>
            <if test="name != null and name != ''">
                and name like concat('%', #{name}, '%')
            </if>
        </where>
        order by id
    </select>

    <!-- 批量删除前的守卫：统计这批 id 里有多少条在起售。status = 1 即 StatusConstant.ENABLE。
         用 count(*) 而不是把行查出来，只需要判断"有没有"；id 不存在的行自然不计入，
         所以"删一个已经被别人删掉的菜品"不会在这里被拒。
         单参数集合必须写 @Param("ids")，XML 这边才认 collection="ids"：
         不写注解时 MyBatis 只暴露 collection / list 两个键，会抛 BindingException，
         而且这条路径只在第一次真正调用时才炸。 -->
    <select id="countOnSaleByIds" resultType="java.lang.Integer">
        select count(*)
        from dish
        where status = 1
        and id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 删除菜品前记下这批菜品引用的图片：行删掉之后就再也查不出该清理哪些文件了。
         两条细节：
         - `image is not null` 不能省，否则结果里会混进 null，下游要额外判空；
         - distinct 让共用同一张图的几道菜只产生一条记录，免得对同一个文件重复删。
         单参数集合必须写 @Param("ids")，XML 这边才认 collection="ids"（同 countOnSaleByIds）。 -->
    <select id="listImagesByIds" resultType="java.lang.String">
        select distinct image
        from dish
        where image is not null
        and id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 批量删除菜品。调用方已保证先删 dish_flavor，且 ids 非空（空集合拼出来的 in () 是语法错误，
         业务层在解析参数时就拦下了空输入）。
         不校验影响行数：id 不存在的行不参与删除，MySQL 返回 0 行，业务层不当作失败——
         前端重复点击删除、或菜品已被别人删掉，都应该是幂等的。 -->
    <delete id="deleteByIds">
        delete from dish where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 动态更新：只写入非 null 字段，调用方传什么就改什么。
         update_time / update_user 的 <if> 不能省：AutoFillAspect 在缺少登录上下文时
         会保留实体上的原值（也就是 null），靠这两个 <if> 才不至于把列清成 null —— 那会把上一个操作人抹掉。
         列清单里**没有** create_time / create_user：更新不改创建信息，一旦写进去
         （哪怕值是 null）就等于凭空抹掉了"谁在什么时候建的"。
         dish.name 上有唯一索引 idx_dish_name，重名会抛 DuplicateKeyException，由业务层转成"菜品名称已存在"。 -->
    <update id="update" parameterType="Dish">
        update dish
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="price != null">price = #{price},</if>
            <if test="image != null">image = #{image},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateUser != null">update_user = #{updateUser},</if>
        </set>
        where id = #{id}
    </update>

</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.DishFlavorMapper">

    <!-- 批量新增口味。服务端已经保证 flavors 非空，这里不再套 <if>：
         空集合拼出来的 SQL 是语法错误，与其静默跳过，不如让调用方先判空。
         value 存的是前端 JSON.stringify 出来的字符串（如 ["无糖","多糖"]），由客户端负责格式。 -->
    <insert id="insertBatch" parameterType="list">
        insert into dish_flavor (dish_id, name, value) values
        <foreach collection="flavors" item="flavor" separator=",">
            (#{flavor.dishId}, #{flavor.name}, #{flavor.value})
        </foreach>
    </insert>

    <!-- 按菜品id批量删除口味，删除菜品时先清子表再删主表：dish_flavor 与 dish 之间没有外键，
         先删主表就会留下一批指向不存在菜品的口味行，它们在任何按 dish_id 查口味的逻辑里都看不到。
         条件是 dish_id in (...)，只匹配本次要删的菜品，别的菜品的口味一行都不受影响。
         单参数集合必须写 @Param("ids")，否则 collection="ids" 绑定不上（见 insertBatch 那段的同类问题）。 -->
    <delete id="deleteByDishIds">
        delete from dish_flavor where dish_id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
